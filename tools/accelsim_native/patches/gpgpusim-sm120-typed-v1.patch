diff --git a/src/sim28_register.h b/src/sim28_register.h
new file mode 100644
index 0000000..80b6e51
--- /dev/null
+++ b/src/sim28_register.h
@@ -0,0 +1,26 @@
+// SIM28 synthetic register-bank/typed-dependency mechanism. Apache-2.0.
+// Logical register identity is distinct from bank position and lane accounting.
+// This is an experimental model, not Blackwell physical register-file timing.
+#ifndef ARCH_EXPLORER_SIM28_REGISTER_H
+#define ARCH_EXPLORER_SIM28_REGISTER_H
+#include <cassert>
+inline bool sim28_typed(unsigned id) { return id >= 0x10001 && id <= 0x40100; }
+inline unsigned sim28_kind(unsigned id) { assert(sim28_typed(id)); return (id >> 16)-1; }
+inline unsigned sim28_index(unsigned id) { assert(sim28_typed(id)); return (id & 65535)-1; }
+inline unsigned sim28_encode(unsigned kind, unsigned index) {
+  assert(kind < 4);
+  assert(index < (kind < 2 ? 256u : 8u));
+  if (index == (kind < 2 ? 255u : 7u)) return 0; // RZ, URZ, PT, UPT
+  return ((kind+1)<<16) | (index+1);
+}
+inline bool sim28_uniform(unsigned id) { return sim28_typed(id) && (sim28_kind(id)==1 || sim28_kind(id)==3); }
+inline unsigned sim28_bank(unsigned id, unsigned wid, unsigned total, bool sub, unsigned per_sched, unsigned sched) {
+  assert(sim28_typed(id) && total%4==0);
+  unsigned width=total/4, local=sub ? per_sched/4 : width;
+  assert(local>0 && (!sub || per_sched%4==0));
+  unsigned kind=sim28_kind(id), index=sim28_index(id);
+  // Four independent synthetic bank spaces. Uniform accesses are warp-wide.
+  unsigned bank=kind*width+(sub ? sched*local : 0)+(index+(sim28_uniform(id)?0:wid))%local;
+  assert(bank<total);return bank;
+}
+#endif
